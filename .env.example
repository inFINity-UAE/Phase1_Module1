# Use Supabase publishable + secret keys (not legacy anon / service_role).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Module B document OCR queue (feature-spec-1_1_B.md §4).
# Dev and prod use the same variable. Dev example: redis://127.0.0.1:6379
# When unset, the rest of the API still boots; document-batch routes return 503.
REDIS_URL=
# Batch submission stays off until Redis is up and this is true. Single-document upload does not need it.
DOCUMENT_OCR_BATCH_ENABLED=
BILL_DOCUMENT_BUCKET=bill-documents
# Veryfi Hub → Settings → Keys. Also read by scripts/veryfi_spike.py.
# CLIENT_SECRET is not used (this repo uses apikey auth, not request signatures).
VERYFI_CLIENT_ID=
VERYFI_USERNAME=
VERYFI_API_KEY=
VERYFI_WEBHOOK_SECRET=
